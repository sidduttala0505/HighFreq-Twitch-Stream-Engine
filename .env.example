# Copy to .env and fill in, then: set -a && source .env && set +a

# Twitch application - register one at https://dev.twitch.tv/console
# (OAuth Redirect URL: http://localhost:3000)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# User access token with the clips:edit scope. App tokens will NOT work for
# creating clips. Easiest way to get one is the Twitch CLI:
#   twitch token -u -s 'clips:edit'
# Heads up: these expire after a few hours, so re-run that before a demo.
TWITCH_USER_TOKEN=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=
